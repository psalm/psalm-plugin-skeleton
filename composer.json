{
    "name": "weirdan/psalm-plugin-skeleton",
    "description": "Template to create psalm-plugin projects from",
    "license": "MIT",
    "type": "psalm-plugin",
    "authors": [
        {
            "name": "Bruce Weirdan",
            "email": "weirdan@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/psalm/psalm-plugin-skeleton/issues",
        "source": "https://github.com/psalm/psalm-plugin-skeleton"
    },
    "require": {
        "psalm/psalm-plugin-api": "^0.4 || ^0.5",
        "vimeo/psalm": "^7 || dev-master"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0",
        "psalm/plugin-phpunit": "^0.21.0",
        "squizlabs/php_codesniffer": "^3.3",
        "weirdan/codeception-psalm-module": "^0.14.1",
        "weirdan/prophecy-shim": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Weirdan\\PsalmPluginSkeleton\\": [
                "."
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weirdan\\PsalmPluginSkeleton\\Tests\\": [
                "tests/_support",
                "tests"
            ]
        }
    },
    "extra": {
        "psalm": {
            "pluginClass": "Weirdan\\PsalmPluginSkeleton\\Plugin"
        }
    },
    "scripts": {
        "acceptance-tests": "codecept build && codecept --ansi run acceptance",
        "analyze": "codecept build && psalm",
        "check": [
            "@analyze",
            "@cs-check",
            "@unit-tests",
            "@acceptance-tests"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "unit-tests": "phpunit --colors=always"
    }
}
